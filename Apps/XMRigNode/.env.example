# XMRig headless node
# Copy to .env and set your real values locally. Do not commit .env.

XMR_WALLET=
XMR_POOL=pool.supportxmr.com:3333
WORKER_NAME=xmrig-node

# all = use every logical CPU visible to Docker
# auto = let XMRig choose its RandomX profile
# or set a number, for example: XMRIG_THREADS=8
XMRIG_THREADS=all
CPU_THREADS_HINT=100
