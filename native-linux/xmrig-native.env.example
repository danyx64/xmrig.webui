# Native Linux/Fedora XMRig node for XMRig Unified WebUI.
# Copy to /etc/xmrig-native.env and edit locally. Do not commit the real file.

# Path to your native XMRig executable.
XMRIG_BIN=/home/YOUR_USER/xmrig/build/xmrig

XMR_POOL=pool.supportxmr.com:3333
XMR_WALLET=YOUR_MONERO_WALLET
WORKER_NAME=PC-01

# all = one mining thread per logical CPU
# auto = let XMRig choose the RandomX profile
# or use a number such as 6
XMRIG_THREADS=all

XMRIG_HTTP_HOST=0.0.0.0
XMRIG_HTTP_PORT=18088

# Optional. If set, enter the same token in the dashboard node settings.
XMRIG_API_TOKEN=
